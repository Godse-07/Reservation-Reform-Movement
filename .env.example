# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEB_APP_URL: Google Apps Script Web App URL for Google Sheets Pledge database
GOOGLE_SHEETS_WEB_APP_URL="https://script.google.com/macros/s/AKfycbx_MOCK_PLEDGE_SHEETS_WEB_APP_KEY/exec"
VITE_GOOGLE_SHEETS_WEB_APP_URL="https://script.google.com/macros/s/AKfycbx_MOCK_PLEDGE_SHEETS_WEB_APP_KEY/exec"
